<Project>
  <ItemGroup>
    <!-- Packages that Microsoft.Azure.StackExchangeRedis depends on at runtime. Upgrades can create binding redirect pain in .NET Framework applications! -->
    <PackageVersion Include="Microsoft.Extensions.Azure" Version="1.14.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="11.0.0" />
    <PackageVersion Include="StackExchange.Redis" Version="3.4.35" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <!-- Packages used at build time or elsewhere in the solution. Upgrade at will. -->
    <PackageVersion Include="Microsoft.Azure.StackExchangeRedis" Version="3.3.1" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OutputCaching.StackExchangeRedis" Version="10.0.8" />
    <PackageVersion Include="FakeItEasy" Version="9.0.1" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.3" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.3" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="11.0.1" />
  </ItemGroup>
</Project>